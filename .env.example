# Copy to .env and change SECRET_KEY before running.

# Postgres (used by docker-compose)
POSTGRES_USER=ieee
POSTGRES_PASSWORD=ieee_dev_password
POSTGRES_DB=ieee_learning
POSTGRES_PORT=5432

# SQLAlchemy connection string.
# Inside Docker the host is `db` (the compose service name).
# If you run uvicorn on the host instead, use localhost.
DATABASE_URL=postgresql://ieee:ieee_dev_password@db:5432/ieee_learning

# JWT — generate a long random string for anything beyond local dev
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
